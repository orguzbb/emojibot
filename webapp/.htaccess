DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Route API calls to PHP proxy
RewriteRule ^api/preview/?$ api/index.php [QSA,L]
RewriteRule ^api/generate/?$ api/index.php [QSA,L]
RewriteRule ^api/batch_preview/?$ api/index.php [QSA,L]
RewriteRule ^api/user_packs/?$ api/index.php [QSA,L]
RewriteRule ^api/add_to_pack/?$ api/index.php [QSA,L]
RewriteRule ^api/(.*)$ api/index.php [QSA,L]
</IfModule>
